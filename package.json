{
  "name": "munna-pen-center",
  "version": "1.0.0",
  "private": true,
  "description": "Munna Pen Center — wholesale stationery & office supplies, Dhanbad, Jharkhand. B2B website, built to grow into quotations, invoicing and an AI-assisted sales agent.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "check": "npm run typecheck && npm run lint && npm run test",
    "enquiries": "node scripts/list-enquiries.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:test-migration": "psql \"$TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -q -t -f prisma/tests/migration-checks.sql",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed-catalogue.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
