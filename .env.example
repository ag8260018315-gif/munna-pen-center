# Munna Pen Center — environment variables
#
# Copy this file to `.env.local` and fill in what you need. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and are never sent to the browser.
# Leave a variable empty to leave it unset.

# ── Public (safe to expose) ────────────────────────────────────────────────
# Canonical site URL — used for sitemap, canonical links and Open Graph. Set in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── V1: enquiry storage ────────────────────────────────────────────────────
# Directory for the file-backed enquiry store (needs a persistent disk). Default: ./.data
ENQUIRY_DATA_DIR=

# ── Phase 2: database & admin authentication ───────────────────────────────
DATABASE_URL=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Phase 3: AI sales agent & WhatsApp Business Platform ───────────────────
AI_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Phase 4: GST / e-invoicing provider ────────────────────────────────────
GST_API_KEY=
GST_API_SECRET=
