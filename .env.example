# Munna Pen Center — environment variables
#
# Copy this file to `.env.local` and fill in what you need. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and are never sent to the browser.
# Leave a variable empty to leave it unset.

# ── Public (safe to expose) ────────────────────────────────────────────────
# Canonical site URL — used for sitemap, canonical links and Open Graph. Set in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Business details that must not live in source code ─────────────────────
# GSTIN (15 characters). NOT shown on the website (it only says "GST Registered"); used for invoices and the admin later.
BUSINESS_GSTIN=

# ── V1: enquiry storage ────────────────────────────────────────────────────
# Directory for the file-backed enquiry store (needs a persistent disk). Default: ./.data
ENQUIRY_DATA_DIR=

# ── Phase 2: database & admin authentication ───────────────────────────────
# Where the public catalogue is read from: "static" (built-in lists in data/, the default) or "database".
# Switch to "database" only after real products have been added to the database. Enquiries always use the database
# when DATABASE_URL is set.
CATALOGUE_SOURCE=
# Supabase PostgreSQL. DATABASE_URL: the pooled (transaction) connection string, used by the app on Vercel.
DATABASE_URL=
# DIRECT_URL: the direct connection string, used only to run migrations.
DIRECT_URL=
# Supabase project URL and the service-role key (server-only; bypasses row security). Used for product-image Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# One-time key for creating the first admin at /admin/setup (works only while no admin exists). Delete it afterwards.
# Generate with: openssl rand -base64 24
ADMIN_SETUP_TOKEN=

# ── Phase 3: AI sales agent & WhatsApp Business Platform ───────────────────
AI_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Phase 4: GST / e-invoicing provider ────────────────────────────────────
GST_API_KEY=
GST_API_SECRET=
