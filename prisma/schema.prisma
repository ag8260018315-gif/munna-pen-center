// Munna Pen Center — database schema (PostgreSQL).
//
// STATUS: design only. V1 of the website does not connect to a database yet
// (it uses static catalogue data + a file-backed enquiry store behind the
// repository interfaces in lib/repositories). This schema is the target for
// Phase 2. Validate it any time with `npm run db:validate`.
//
// Conventions
//  • Money is Decimal(12,2), INR. Prices are NEVER stored on Product: wholesale prices
//    are quoted per customer and per quantity, so they live on QuotationItem / OrderItem.
//  • No stock quantities are stored yet — add an InventoryItem model when stock tracking is real.
//  • Every commercial document (Quotation, Order, Invoice) is created as a DRAFT and
//    moves forward only through the owner-approval gate (see ApprovalRequest).
//  • Nothing the business must be able to prove is hard-deleted by the application. Relations to Lead, Customer,
//    Enquiry, Quotation, Order, Invoice, and to the staff member who decided or recorded something, use
//    onDelete: Restrict. "Removing" one means a status (LOST, SPAM, CANCELLED, VOID…), deactivating an AdminUser
//    (isActive = false) or anonymising personal data in place. Only line items cascade from their own parent.
//    Restrict protects a PARENT from deletion; it does not stop a direct delete of a leaf row such as a Payment or
//    an ApprovalRequest — the first migration blocks that too (see the list below).
//  • Rules Prisma cannot express — add them to the first migration as raw SQL:
//      ApprovalRequest:
//        - CHECK that exactly one of quotationId/orderId/invoiceId/leadId/customerId is set (create this FIRST);
//        - CHECK (status <> 'APPROVED' OR (decidedById IS NOT NULL AND decidedAt IS NOT NULL AND decidedByRole = 'OWNER'));
//        - CHECK (executedAt IS NULL OR status = 'APPROVED');
//        - one open request per target:
//            CREATE UNIQUE INDEX ... ON "ApprovalRequest" (action,
//              COALESCE("quotationId", "orderId", "invoiceId", "leadId", "customerId")) WHERE status = 'PENDING';
//          COALESCE matters: NULLs are distinct in a plain unique index, so listing the five columns would never fire;
//        - a BEFORE UPDATE trigger that rejects any change to action, payload, payloadHash, expiresAt, requestedBy and
//          the target keys once decidedAt is set (an approved row is frozen; only executedAt may be set, once);
//        - which target column an action may use is checked in TypeScript (ACTION_TARGET_TYPES in lib/ai-sales/policy.ts).
//      Quotation: a trigger that it cannot leave DRAFT while any QuotationItem unitPrice is NULL (a CHECK cannot span
//                 tables), and that a line with priceSetBy = AI_AGENT has a priceApprovalId pointing at an APPROVED
//                 PROPOSE_PRICE request.
//      Invoice: CHECK (status IN ('DRAFT', 'PENDING_APPROVAL') OR (number IS NOT NULL AND financialYear IS NOT NULL
//               AND sequence IS NOT NULL)); an ISSUED invoice is immutable (trigger); customerId must equal the
//               order's customerId (trigger or composite foreign key).
//      Catalogue: CHECK (purchasePrice, wholesalePrice, retailPrice >= 0); CHECK (stockQuantity >= 0);
//                 CHECK (minOrderQuantity >= 1); CHECK (gstRatePercent BETWEEN 0 AND 100);
//                 UNIQUE INDEX ON "Brand" (lower(name)) and ON "Category" (lower(name)).
//      Supabase: ENABLE ROW LEVEL SECURITY on EVERY table, with no policies. Supabase exposes tables to its public REST
//                API unless row-level security is on; this app reaches the database only from the server (Prisma, via
//                DATABASE_URL), which is unaffected, and the browser never gets a Supabase key. The prices above must
//                never be readable through the public API.
//      Evidence tables (ApprovalRequest, Payment, FollowUp, Invoice, InvoiceItem): REVOKE DELETE from the application's
//               database role, or add a BEFORE DELETE trigger that raises.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// ───────────────────────────── Enums ─────────────────────────────

enum AdminRole {
  OWNER
  STAFF
}

/// Who performed an action. AI actions are always attributable.
enum ActorType {
  ADMIN
  AI_AGENT
  CUSTOMER
  SYSTEM
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CustomerType {
  SCHOOL
  OFFICE
  ENGINEER
  BUSINESS
  INSTITUTION
  RETAILER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  REFERRAL
  AI_AGENT
  OTHER
}

enum EnquirySource {
  BULK_ORDER_FORM
  QUOTE_FORM
  CONTACT_FORM
  WHATSAPP
  PHONE
  AI_AGENT
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
  SPAM
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  PAYMENT_REMINDER
  REPEAT_ORDER
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

/// Commercial actions that require the owner's decision. Mirrors lib/ai-sales/policy.ts.
enum ApprovalAction {
  PROPOSE_PRICE
  APPLY_DISCOUNT
  SEND_QUOTATION
  CONFIRM_ORDER
  ISSUE_INVOICE
  REQUEST_PAYMENT
  SCHEDULE_DELIVERY
  CANCEL_ORDER
  SEND_CUSTOMER_MESSAGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// ───────────────────────────── Staff ─────────────────────────────

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  role             AdminRole @default(STAFF)
  /// Null until a sign-in method is chosen (credentials / email link / SSO).
  passwordHash     String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  /// Brute-force protection: consecutive failed sign-ins, and the time before which sign-in is refused.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions AdminSession[]

  assignedLeads     Lead[]
  assignedFollowUps FollowUp[]
  decidedApprovals  ApprovalRequest[]
  recordedPayments  Payment[]
}

/// A signed-in admin browser session (server-side sessions). The browser holds only a random token in an HttpOnly
/// cookie; the database stores its SHA-256 hash, so a leaked table or backup cannot be used to sign in. Deleting a
/// session (sign-out, expiry, "sign out everywhere") is the one place a hard delete is right.
model AdminSession {
  id         String   @id @default(cuid())
  /// SHA-256 (hex) of the session token. Never the token itself.
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  /// For the admin's "where am I signed in" list. Free text, length-limited by the application.
  userAgent  String?
  createdAt  DateTime @default(now())

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

/// ──────────────────────────── Catalogue ───────────────────────────

model Category {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  summary        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  /// Optional nesting, for sub-categories later.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

/// A brand the business can supply (DOMS, Cello, Casio…). Kept in its own table: a brand is not a product, and a
/// product can exist with no brand stated. Nothing is priced or stocked at brand level.
model Brand {
  id               String  @id @default(cuid())
  slug             String  @unique
  /// Unique ignoring case is enforced in the migration (see the header).
  name             String  @unique
  /// Shown on the public website. False until the owner confirms the brand should be shown.
  isListedPublicly Boolean @default(false)
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A catalogue product. Only the owner enters real products here — nothing is pre-filled with invented SKUs, prices,
/// GST rates, HSN codes or stock. Every business-specific value is nullable: NULL means "not entered yet", never 0.
///
/// The three prices below are INTERNAL. The website must never show them (it says "Get Wholesale Price" /
/// "Request Quote"): the public catalogue repository selects only public columns, and the public `Product` type in
/// lib/domain/types.ts has no price field. Wholesale prices are still quoted per customer and quantity — these are
/// list prices that seed a quotation, which the owner approves (see ApprovalRequest).
model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  /// The business's own stock-keeping code. NULL until the owner assigns one (several NULLs are allowed).
  sku              String? @unique
  name             String
  shortDescription String?
  description      String?
  /// Unit of sale, e.g. "piece", "box", "dozen". Free text until the owner's units are known.
  unit             String?
  /// e.g. "Box of 10 · Carton of 100". Free text until pack structures are defined.
  packSize         String?

  /// INTERNAL prices, INR, ex-GST unless the owner decides otherwise. NULL = not entered.
  purchasePrice  Decimal? @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  retailPrice    Decimal? @db.Decimal(12, 2)

  /// For GST invoicing. Fill from the business's real tax data — never guessed.
  hsnCode        String?
  gstRatePercent Decimal? @db.Decimal(5, 2)

  /// NULL = stock not tracked / unknown; 0 = tracked and out of stock.
  stockQuantity    Int?
  minOrderQuantity Int?

  /// Public URL of the image, and its object path in the Supabase Storage bucket (so it can be replaced or removed).
  imageUrl  String?
  imagePath String?
  imageAlt  String?

  tags       String[]
  /// DRAFT = being prepared, ACTIVE = visible on the website, INACTIVE = hidden (deactivated, not deleted).
  status     ProductStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

/// ─────────────────────────── CRM / sales ──────────────────────────

/// A prospective buyer who has contacted us but has not yet been quoted or ordered.
model Lead {
  id               String     @id @default(cuid())
  name             String
  organizationName String?
  /// E.164, e.g. +917979025166
  phone            String
  email            String?
  city             String?
  state            String?
  source           LeadSource @default(WEBSITE)
  status           LeadStatus @default(NEW)
  notes            String?

  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Set when the lead is converted (first quotation draft / accepted order).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  enquiries Enquiry[]
  followUps FollowUp[]
  approvals ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([customerId])
}

/// A buying organisation (or individual) we have quoted or sold to.
model Customer {
  id               String       @id @default(cuid())
  type             CustomerType @default(OTHER)
  organizationName String
  contactName      String
  phone            String
  email            String?
  /// Buyer's GSTIN, as supplied by them. Needed for GST invoices.
  gstin            String?

  billingLine1    String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  shippingLine1   String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?

  notes String?

  leads      Lead[]
  quotations Quotation[]
  orders     Order[]
  invoices   Invoice[]
  followUps  FollowUp[]
  approvals  ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

/// What a customer asked for, from any channel.
model Enquiry {
  id                     String        @id @default(cuid())
  /// Customer-facing reference, e.g. ENQ-20261006-K4PZ.
  reference              String        @unique
  source                 EnquirySource
  status                 EnquiryStatus @default(NEW)
  productsRequired       String
  approximateQuantity    String?
  additionalRequirements String?
  city                   String?
  state                  String?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Restrict)

  items      EnquiryItem[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model EnquiryItem {
  id           String  @id @default(cuid())
  /// Null when the customer asked for something that is not in the catalogue.
  productId    String?
  productName  String
  quantityNote String?

  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([productId])
}

/// ───────────────── Quotation → Order → Invoice → Payment ─────────────────

model Quotation {
  id         String          @id @default(cuid())
  /// e.g. QT-2026-0001 — issued when the quotation is first saved.
  number     String          @unique
  status     QuotationStatus @default(DRAFT)
  /// No default on purpose: every code path must say who acted, so AI work is never recorded as a person's.
  createdBy  ActorType
  validUntil DateTime?
  currency   String          @default("INR")
  /// NULL until every line has been priced by (or approved by) the owner. A draft must never show a made-up total.
  subtotal   Decimal?        @db.Decimal(12, 2)
  taxTotal   Decimal?        @db.Decimal(12, 2)
  total      Decimal?        @db.Decimal(12, 2)
  terms      String?
  notes      String?
  sentAt     DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiryId  String?
  enquiry    Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  items     QuotationItem[]
  order     Order?
  approvals ApprovalRequest[]
  followUps FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([enquiryId])
  @@index([status])
}

model QuotationItem {
  id              String           @id @default(cuid())
  description     String
  quantity        Int
  unit            String           @default("pcs")
  /// NULL = "not priced yet". Set only by the owner, or proposed by the agent and approved by the owner
  /// (ApprovalAction PROPOSE_PRICE). Never 0 as a stand-in: 0 would be indistinguishable from "free".
  unitPrice       Decimal?         @db.Decimal(12, 2)
  hsnCode         String?
  /// NULL until confirmed from the business's real tax data. Never guessed.
  gstRatePercent  Decimal?         @db.Decimal(5, 2)
  lineTotal       Decimal?         @db.Decimal(12, 2)
  /// Who set the price. NULL while unpriced. A price set by the AI agent is only a PROPOSAL until the owner approves it.
  priceSetBy      ActorType?
  /// The APPROVED PROPOSE_PRICE request that covers an agent-set price (required when priceSetBy = AI_AGENT).
  priceApprovalId String?
  priceApproval   ApprovalRequest? @relation(fields: [priceApprovalId], references: [id], onDelete: Restrict)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
  @@index([priceApprovalId])
}

model Order {
  id        String      @id @default(cuid())
  /// e.g. ORD-2026-0001
  number    String      @unique
  status    OrderStatus @default(PENDING_CONFIRMATION)
  /// Who created this order (staff, the AI agent via an approved action, or the system).
  createdBy ActorType
  currency  String      @default("INR")
  subtotal  Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal  Decimal     @default(0) @db.Decimal(12, 2)
  total     Decimal     @default(0) @db.Decimal(12, 2)

  shippingLine1     String?
  shippingCity      String?
  shippingState     String?
  shippingPincode   String?
  /// Transport / courier details, recorded when dispatched.
  transporter       String?
  trackingReference String?
  confirmedAt       DateTime?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  notes             String?

  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// An order is created from at most one accepted quotation.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  items     OrderItem[]
  invoices  Invoice[]
  approvals ApprovalRequest[]
  followUps FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  description    String
  quantity       Int
  unit           String  @default("pcs")
  unitPrice      Decimal @db.Decimal(12, 2)
  hsnCode        String?
  gstRatePercent Decimal @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id            String        @id @default(cuid())
  /// Consecutive serial number required on GST invoices. NULL while DRAFT; allocated from NumberSequence at the
  /// moment the invoice is ISSUED (never before — drafts must not burn numbers and leave gaps).
  number        String?       @unique
  /// The Indian financial year ("2026-27", computed in Asia/Kolkata) and the sequence value behind `number`, filled
  /// together with it when the invoice is ISSUED. Together they make "unique per series and financial year" a real
  /// constraint, whatever format `number` has.
  financialYear String?
  sequence      Int?
  status        InvoiceStatus @default(DRAFT)
  /// Who created this invoice (staff, the AI agent via an approved action, or the system).
  createdBy     ActorType

  issueDate DateTime?
  dueDate   DateTime?
  currency  String    @default("INR")
  subtotal  Decimal   @default(0) @db.Decimal(12, 2)
  cgstTotal Decimal   @default(0) @db.Decimal(12, 2)
  sgstTotal Decimal   @default(0) @db.Decimal(12, 2)
  igstTotal Decimal   @default(0) @db.Decimal(12, 2)
  total     Decimal   @default(0) @db.Decimal(12, 2)

  /// Snapshots written when the invoice is ISSUED, so later edits to the Customer or to the business's own
  /// details can never alter an invoice that has already been sent. Filled from real data — never guessed.
  buyerName       String?
  buyerAddress    String?
  buyerGstin      String?
  placeOfSupply   String?
  supplierName    String?
  supplierAddress String?
  supplierGstin   String?
  /// Filled by the e-invoicing / GST provider integration, if used.
  irn             String?

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items     InvoiceItem[]
  payments  Payment[]
  approvals ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([financialYear, sequence])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  description    String
  quantity       Int
  unit           String  @default("pcs")
  unitPrice      Decimal @db.Decimal(12, 2)
  hsnCode        String?
  gstRatePercent Decimal @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id               String        @id @default(cuid())
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  /// UTR / transaction id / cheque number.
  reference        String?
  /// Id from a payment gateway, if one is integrated later.
  gatewayPaymentId String?
  paidAt           DateTime?
  notes            String?

  invoiceId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// Payments are recorded by staff; the AI agent never records or moves money.
  recordedById String?
  recordedBy   AdminUser? @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
}

/// ───────────────────── Follow-ups & owner approvals ─────────────────────

model FollowUp {
  id          String         @id @default(cuid())
  type        FollowUpType
  status      FollowUpStatus @default(OPEN)
  dueAt       DateTime
  notes       String?
  createdBy   ActorType
  completedAt DateTime?

  /// A follow-up attaches to whichever record it concerns.
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([leadId])
  @@index([customerId])
}

/// The owner-approval gate. The AI agent (or staff) files a request; the commercial action may execute only
/// after the OWNER sets status = APPROVED — and only for exactly what was approved. lib/ai-sales/policy.ts
/// `canExecute` checks: same action, same target record, same payloadHash, decided by an OWNER, not yet
/// executed, expiry valid and in the future.
model ApprovalRequest {
  id           String         @id @default(cuid())
  action       ApprovalAction
  status       ApprovalStatus @default(PENDING)
  requestedBy  ActorType
  /// Human-readable summary shown to the owner, e.g. "Send quotation QT-2026-0007 to ABC School (₹…)".
  summary      String
  /// The exact change being approved — what will be executed if approved. Mandatory, and the owner's approval
  /// screen must be rendered FROM this (or `summary` generated from it on the server): a free-text summary written by
  /// the agent is not evidence of what will run.
  payload      Json
  /// SHA-256 (hex) of the canonical payload (lib/ai-sales/payload-hash.ts). Changing a price or the wording
  /// after approval changes the hash, which voids the approval.
  payloadHash  String
  /// Mandatory: an approval without a clear expiry authorises nothing.
  expiresAt    DateTime
  decidedAt    DateTime?
  decisionNote String?
  /// Set, in the same transaction as the action itself, when the approved action has been carried out. An
  /// approval authorises ONE execution.
  executedAt   DateTime?

  decidedById   String?
  decidedBy     AdminUser? @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  /// The decider's role AT THE MOMENT OF DECISION. `canExecute` reads this, not the user's current role, so a later
  /// promotion cannot turn an old staff decision into an owner decision (and a later demotion cannot erase one).
  decidedByRole AdminRole?

  /// Exactly one of the following is set (enforced by a CHECK in the migration). SEND_CUSTOMER_MESSAGE targets a Lead or Customer.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceId   String?
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Quotation lines whose price this approval (PROPOSE_PRICE) covers.
  pricedItems QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([quotationId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([leadId])
  @@index([customerId])
}

/// Gap-free serial numbers (GST invoices must be consecutive). One row per series per Indian financial year,
/// e.g. scope "INV", financialYear "2026-27" (the year rolls over on 1 April in Asia/Kolkata, not UTC). Allocate with a
/// single row-locking upsert INSIDE the same transaction that writes the document, so a rollback also rolls the number
/// back and no gap appears — and so the first invoice of a new year (no row yet) works:
///   INSERT INTO "NumberSequence" (id, scope, "financialYear", "lastValue", "updatedAt")
///   VALUES ($1, 'INV', '2026-27', 1, now())
///   ON CONFLICT (scope, "financialYear") DO UPDATE SET "lastValue" = "NumberSequence"."lastValue" + 1, "updatedAt" = now()
///   RETURNING "lastValue";
/// Whether the series needs a length limit or a particular format is a question for the business's accountant.
model NumberSequence {
  id            String   @id @default(cuid())
  /// "INV", "QT", "ORD"…
  scope         String
  /// Indian financial year, April–March: "2026-27".
  financialYear String
  lastValue     Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([scope, financialYear])
}
